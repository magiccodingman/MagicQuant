<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Blake3" Version="2.2.0" />
      <PackageReference Include="DuckDB.NET.Data.Full" Version="1.4.3" />
      <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
      <PackageReference Include="Spectre.Console" Version="0.54.0" />
      <PackageReference Include="System.Management" Version="10.0.1" />
      <PackageReference Include="YamlDotNet" Version="17.0.1" />
    </ItemGroup>

    <ItemGroup>
      <None Update="Helpers\pip_runner.py">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="config.default.yaml">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="config.dev.yaml">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="DuckDB\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\MQ.DB\MQ.DB.csproj" />
    </ItemGroup>

</Project>
